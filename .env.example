# Copy to .env and fill in. Never commit .env.

# "testnet" only for the hackathon.
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org

# Secret key (S...) of the single sponsor account: pays fees and reserves,
# creates the claimable balances and recovers them after expiration.
SPONSOR_SECRET=

# Comma-separated secrets of the channel accounts (tx source + fee payer of
# each open). Created and appended to .env by: npm run create-channels
CHANNEL_SECRETS=

# Salt for scrypt(code, salt) -> Kadó keypair. Changing it invalidates every code.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CODE_SALT=
